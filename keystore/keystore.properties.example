# Release signing credentials — copy to `keystore.properties` and fill in.
# `keystore.properties` is in .gitignore. NEVER commit it.
#
# The keystore file itself (`keystore/echoling-release.keystore`) is also
# in .gitignore. Losing it means losing the ability to publish updates
# under the same package name on 应用商店 (signature mismatch → "该应用
# 未安装" / "package already exists with different signature").
# Keep a backup on an encrypted USB drive or in 1Password.
storeFile=keystore/echoling-release.keystore
storePassword=echoling_release_2026
keyAlias=echoling
keyPassword=echoling_release_2026
