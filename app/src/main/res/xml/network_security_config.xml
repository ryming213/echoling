<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: allow cleartext only for debug, production should be HTTPS-only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Certificate pinning intentionally disabled — see CLAUDE.md §9.1.
      A previous build held placeholder SHA-256 pins for the Baidu
      translation host which blocked the real certificate; the
      translation API path has since been removed entirely and the
      placeholder pins are no longer needed. Re-introduce real pins
      here only when an HTTPS host is actually consumed.
    -->

    <!-- Debug configuration - less strict for testing -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
