<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- (2026-07-04) INTERNET + ACCESS_NETWORK_STATE removed.
         The app is fully offline: the Vosk STT model is bundled
         in `assets/models/` and copied to internal storage by
         [com.echoling.app.speech.ModelManager] on first launch —
         no network code path remains in the codebase. Declaring
         either of these would fail the 国内应用商店 "用不到的网络
         权限" review (华为 / 小米 / OPPO / vivo / 应用宝 all flag
         undeclared-but-unused network perms and ask for a
         justification that doesn't exist). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Package visibility queries (Android 11 / API 30+).

        On Android 11+ apps can't see packages they don't explicitly
        declare an interest in. `PackageManager.queryIntentServices`
        and `queryIntentActivities` silently return empty for all
        undeclared packages — this is enforced at the framework level,
        not the OS level, so it affects even permissions you have.

        TtsManager at com.echoling.app.player.TtsManager uses
        queryIntentServices(Intent(TTS_SERVICE)) to discover all TTS
        engines the system has installed. Without this <queries>
        element, the discovery list is empty even when Google TTS is
        installed (e.g. Xiaomi Mi 11 CN devices after manually
        sideloading the Google TTS APK — the package exists, the
        service works in Settings, but our app can't see it).

        Declaring the TTS_SERVICE intent here lets queryIntentServices
        return com.google.android.tts / com.iflytek.speechsuite /
        com.xiaomi.tts / etc. when they're installed.

        Related: see also the QUERY_ALL_PACKAGES-free pattern in
        https://developer.android.com/training/package-visibility/declaring
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".EchoLingApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EchoLing">
        <!--
            (2026-07-16) Disable WorkManager's default initialization
            so our HiltWorkerFactory (in EchoLingApplication.kt) is
            used instead of the default ReflectiveWorkerFactory.
            Without this, the first .enqueue() of AutoTranscriptionWorker
            throws IllegalStateException: "Attempting to instantiate
            a worker that is not a default worker class" because
            @HiltWorker requires HiltWorkerFactory to construct the
            @AssistedInject parameters.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EchoLing.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
